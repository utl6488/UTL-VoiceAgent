# --- REST API ---
# SQLite file in the backend/ dir by default. Swap for Postgres etc. in prod.
DATABASE_URL=sqlite:///./voiceagent.db
PORT=8000
# CORS origin for the dashboard (Vite dev default).
FRONTEND_ORIGIN=http://localhost:5173

# --- Voice pipeline worker (optional for API-only runs) ---
# Deepgram multilingual STT (hi + en code-switching).
DEEPGRAM_API_KEY=your_deepgram_key_here
# ElevenLabs TTS. Default voice EXAVITQu4vr4xnSDxMaL is a decent multilingual pick.
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Where the pipeline worker POSTs completed records.
BACKEND_URL=http://localhost:8000
